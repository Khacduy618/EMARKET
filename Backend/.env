# CORS phải trỏ đến địa chỉ của frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SANCTUM phải biết domain stateful là của frontend
# Xóa bỏ phần port ở đây nếu cần, chỉ cần tên miền gốc
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# SESSION_DOMAIN phải được set đúng hoặc để trống
# Nếu để trống, nó sẽ dùng domain của APP_URL.
# Bạn có thể thử comment dòng này đi hoặc để là localhost
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_SECURE_COOKIE=false

SESSION_DRIVER=file         # Đổi sang file để loại bỏ yếu tố database
