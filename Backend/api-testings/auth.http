@host=http://127.0.0.1:8000/api
@authToken=your-bearer-token-here
@contentType=application/json

###############################################
# Authentication Routes
###############################################

### Register new user
# Returns: User object with token
POST {{host}}/register
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "Username": "truongdinhhon",
    "FullName": "Project User",
    "Email": "tdhon@gmail.com",
    "Password": "password123",
    "Password_confirmation": "password123",
    "Phone": "1234567890",
    "Role": "Người mua",
    "IsActive": true
}


### Login 1
# Returns: Token and user information
POST {{host}}/login
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "email": "tdhon@gmail.com",
    "password": "password123"
}

### Login 2
# Returns: Token and user information
POST {{host}}/login
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "email": "m17@goat.com",
    "password": "newpassword123"
}

### Logout
# Requires: Bearer token
POST {{host}}/logout
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

###############################################
# Password Management
###############################################

### Request password reset link
POST {{host}}/forgot-password
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "email": "m17@goat.com"
}

### Reset password with token
POST {{host}}/reset-password
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "token": "b5fedfaa456876a3d9507645f4f2ac803baa76ff3835f967b9e9fec98d21e176",
    "email": "m17@goat.com",
    "password": "timetorise",
    "password_confirmation": "timetorise"
}

### Update Password
# Requires: Bearer token
PUT {{host}}/user/password
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "current_password": "current-password",
    "password": "new-password",
    "password_confirmation": "new-password"
}

### Confirm Password
# Requires: Bearer token
POST {{host}}/user/confirm-password
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "password": "your-password"
}

### Check Password Confirmation Status
# Requires: Bearer token
GET {{host}}/user/confirmed-password-status
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

###############################################
# Two Factor Authentication (2FA)
###############################################

### Enable Two Factor Authentication
# Requires: Bearer token
POST {{host}}/user/two-factor-authentication
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Two Factor Challenge (During Login)
POST {{host}}/two-factor-challenge
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "code": "123456"
}

### Get Two Factor QR Code
# Requires: Bearer token
GET {{host}}/user/two-factor-qr-code
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Get Two Factor Recovery Codes
# Requires: Bearer token
GET {{host}}/user/two-factor-recovery-codes
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Generate New Recovery Codes
# Requires: Bearer token
POST {{host}}/user/two-factor-recovery-codes
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Get Two Factor Secret Key
# Requires: Bearer token
GET {{host}}/user/two-factor-secret-key
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Disable Two Factor Authentication
# Requires: Bearer token
DELETE {{host}}/user/two-factor-authentication
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Confirm Two Factor Authentication
# Requires: Bearer token
POST {{host}}/user/confirmed-two-factor-authentication
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

###############################################
# User Profile Management
###############################################

### Update User Profile Information
# Requires: Bearer token
PUT {{host}}/user/profile-information
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "Username": "updated_username",
    "Email": "updated@example.com",
    "FullName": "Updated Full Name",
    "Phone": "1234567890",
    "Level": "normal",
    "Role": "Người mua",
    "IsActive": true
}

###############################################
# Storage
###############################################

### Access Storage File
# Note: May require authentication depending on configuration
GET {{host}}/storage/example.jpg
Authorization: Bearer {{authToken}}

###############################################
# Health Checks
###############################################

### Basic Health Check
GET {{host}}/
Accept: {{contentType}}

### Server Status Check
GET {{host}}/up
Accept: {{contentType}}

