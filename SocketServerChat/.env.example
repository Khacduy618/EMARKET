# Môi trường hoạt động của Node.js (development hoặc production)
NODE_ENV=development

# Port mà Socket.IO server sẽ lắng nghe bên trong container Docker
SOCKET_IO_PORT=3002

MONGODB_URI="mongodb://db_mongo:27017/eMarketChatDB"
# Ví dụ thực tế có thể trông như:
# MONGODB_ATLAS_URI="mongodb+srv://khacduy555:yourCorrectPassword@cluster0.gs6ashk.mongodb.net/eMarketChatDB?retryWrites=true&w=majority&appName=Cluster0"

# URL để Socket.IO server gọi đến API của Laravel (qua Nginx trong Docker network)
# 'nginx' là tên service của Nginx trong docker-compose.yml
# '/api' là prefix bạn đã cấu hình trong Nginx cho API Laravel
LARAVEL_API_URL="http://nginx/api"
# Endpoint đầy đủ của Laravel để Socket.IO server xác thực JWT token
# Token này sẽ được client Next.js gửi lên khi kết nối Socket.IO
LARAVEL_TOKEN_VALIDATION_ENDPOINT="http://nginx/api/auth/validate-socket-token"
NEXTJS_FRONTEND_URL="http://frontend:3000"
INTERNAL_API_SECRET_KEY="0932105214@@"
# (TÙY CHỌN - Nếu bạn muốn Socket.IO server tự xác thực JWT thay vì gọi API Laravel)
# Nếu JWT token của Laravel dùng thuật toán HS256:
# JWT_SECRET_FOR_SOCKET_VERIFICATION="your_laravel_app_key_or_specific_jwt_secret"
#
# Hoặc nếu JWT token của Laravel dùng thuật toán RS256 (khóa bất đối xứng):
# JWT_PUBLIC_KEY_PATH_FOR_SOCKET_VERIFICATION="./storage/oauth-public.key"
# (Đường dẫn này là bên trong container Socket.IO server, bạn cần mount file public key vào container)
# Nếu sử dụng một trong hai biến trên, bạn cần cập nhật logic xác thực trong server.js của Socket.IO.
# Hiện tại, server.js đang dùng LARAVEL_TOKEN_VALIDATION_ENDPOINT.
